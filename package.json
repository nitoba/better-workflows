{
  "name": "better-workflows",
  "version": "0.1.0-alpha.9",
  "description": "Durable workflows, activities, signals and timers with NestJS-native decorators and dependency injection.",
  "keywords": [
    "better-workflows",
    "nestjs",
    "queue",
    "typescript"
  ],
  "homepage": "https://github.com/nitoba/better-workflows#readme",
  "bugs": {
    "url": "https://github.com/nitoba/better-workflows/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/better-workflows.git"
  },
  "bin": {
    "better-workflows": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENCE",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./sqlite": {
      "types": "./dist/sqlite.d.mts",
      "import": "./dist/sqlite.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "import": "./dist/postgres.mjs"
    },
    "./admin": {
      "types": "./dist/admin.d.mts",
      "import": "./dist/admin.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./observability": {
      "types": "./dist/observability.d.mts",
      "import": "./dist/observability.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:postgres": "node tests/run-postgres-tests.mjs",
    "lint": "oxlint --type-aware src tests examples scripts tsdown.config.ts",
    "lint:fix": "oxlint --type-aware --fix src tests examples scripts tsdown.config.ts",
    "format": "oxfmt --write . '!tools/oxlint/**'",
    "format:check": "oxfmt --check . '!tools/oxlint/**'",
    "publint": "publint",
    "check": "bun run typecheck && bun run test && bun run format:check && bun run build && bun run docs:check && bun run lint && bun run publint",
    "hooks:install": "lefthook install",
    "prepublishOnly": "bun run check",
    "example": "bun examples/reports.ts",
    "test:node": "node tests/package/node-smoke.mjs && node tests/package/advanced-smoke.mjs && bun tests/package/consumer/contract-first-types.mts",
    "example:modular": "bun examples/modular.ts",
    "docs:check": "node scripts/check-jsdoc.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/sql-pg": "4.0.0-rc.115",
    "@effect/sql-sqlite-bun": "4.0.0-rc.115",
    "@effect/sql-sqlite-node": "4.0.0-rc.115",
    "@standard-schema/spec": "^1.0.0",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@oxlint/plugins": "1.78.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "1.4.1",
    "@types/node": "^22.0.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=12.0.0 <13.0.0",
    "@nestjs/core": ">=12.0.0 <13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "lefthook"
  ]
}
