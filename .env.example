# Copy to .env. Bun loads it automatically; never commit the real file.
HOST=127.0.0.1
PORT=3000
API_TOKEN=local-development-token-change-me
DATA_DIR=./data

# Required before submitting research. No fallback/mock provider exists in src/.
GOOGLE_GENERATIVE_AI_API_KEY=
ANALYSIS_MODEL=gemini-3.8-flash
JUDGE_MODEL=gemini-3.8-flash
ARXIV_CONTACT_EMAIL=developer@example.com

# Local Mailpit only. In Docker Compose the API service sets SMTP_HOST=mailpit.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=research@local.test
NODE_BINARY=node

PAPER_CONCURRENCY=2
LLM_CONCURRENCY=2
PDF_MAX_BYTES=25000000
PDF_MAX_PAGES=80
PDF_TIMEOUT_MS=120000
DOCUMENT_MAX_CHARS=240000
CHUNK_CHARS=16000
OCR_ENABLED=false
